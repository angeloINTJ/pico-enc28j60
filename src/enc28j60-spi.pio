; Modified to support separate CS pin, to run the SPI clock at up to 20 MHz, and
; to keep the chip select timing that the data sheet asks for at any clock

; The MOSI signal is sampled at the rising edge of the clock, while MISO is
; clocked out at the falling edge. The commands are initiated by pulling Slave
; Select down and terminated by pulling it up.
;
; We extend each command such that the first byte is the size of the TX payload
; in bits, while the second is the size of the RX payload to be clocked in from
; the slave. We use this extra information to time the termination of each
; command and do not actually transmit it. This approach enables efficient DMA
; without us having to care to manually manipulate the slave select pins. It
; would have been more efficient to specify these sizes in bytes or even use two
; bytes for each size field, but I haven't found a way for PIO to do that
; without complicating the encoding of the payload.
;
; There's always at least one TX byte - the command header - as described in
; chapter 4.2 of the manual. Register write commands have one byte of payload
; to transmit, while the memory write can transmit up to 30. This is a
; limitation caused by the fact that PIO cannot pull more than 1 byte at a
; time from the TX FIFO for this config, and cannot post process that byte.
;
; Register read commands don't transmit any payload and receive 1 byte for the
; ETH reads and 2 bytes for MAC and MII reads, the first of which is garbage.
; Memory reads can receive up to 31 bytes of payload. Again, it's a limitation
; of PIO and not the slave.
;
; Each SPI clock takes 4 PIO clocks, 2 with SCK low and 2 with it high, so the
; state machine runs at 4 times the SPI clock (enc28j60_config.spi_hz). Counting
; the bits costs no clock of its own: the jump that closes each loop is one of
; the instructions of the 2 clocks with SCK high.
;
; The chip select timing is counted in PIO clocks, so it is the shorter, the
; faster the clock runs. The program is written for the highest SPI clock of the
; chip, 20 MHz, which makes a PIO clock 12.5 ns, and meets the minimum times of
; table 16-6 of the data sheet (DS39662E) with room to spare at any clock below
; that:
;   TCSS, CS setup, at least 50 ns: 7 clocks from CS low to the first rising edge
;   TCSH, CS hold, at least 210 ns for MAC and MII registers: 20 clocks from the
;     last falling edge of SCK to CS high (the original program kept it low for
;     143 ns after a read, at 3.5 MHz)
;   TCSD, CS disable, at least 50 ns: 7 clocks from CS high to the next CS low,
;     and more when the next command is not in the FIFO yet
;
; PIN CONFIGURATION:
;   side_set 1: SCK pin (configured via sm_config_set_sideset_pins)
;   out pins: MOSI pin (configured via sm_config_set_out_pins)
;   in pins: MISO pin (configured via sm_config_set_in_pins)
;   set pins: CS pin (configured via sm_config_set_set_pins) - 1 pin

.pio_version 0
.program enc28j60_spi
.side_set 1 opt

  ; pull the size of the tx payload to x and the rx payload to y
  out x, 8
  out y, 8

  ; pull the command from the tx fifo and lower the slave select (CS)
  pull block
  ; CS is controlled via set pins - set to 0 (active low). The clock stays low
  ; for 7 PIO clocks (set, delay, the two jumps and the first out): TCSS
  set pins, 0 [2]

  ; x counts the bits to transmit, and the loop below runs once for each, so
  ; it takes bits - 1: a jump to the next instruction, taken or not, is a
  ; decrement. There are no bits to transmit when x is 0, which the commands of
  ; the driver never do.
  jmp !x end_tx
  jmp x-- tx_loop

  ; transmit the command header and the payload: the clock is low for 2 PIO
  ; clocks, with the data bit out, and high for 2
tx_loop:
  out pins, 1 side 0 [1]
  jmp x-- tx_loop side 1 [1]

end_tx:
  ; the same for the bits to receive; y is 0 when there is nothing to receive
  jmp !y end_rx
  jmp y-- rx_loop

  ; clock in the slave's response: the clock is low for 2 PIO clocks, then the
  ; bit is sampled as it rises, because the slave puts it on the line at the
  ; falling edge, and it stays high for 2 clocks
rx_loop:
  nop side 0 [1]
  in pins, 1 side 1
  jmp y-- rx_loop

end_rx:
  ; done transmitting and receiving: lower the clock, and keep the slave select
  ; low for 20 PIO clocks after that: TCSH
  nop side 0 [7]
  nop [7]
  nop [3]
  ; rise slave select to terminate the command; it stays up for this
  ; instruction and its 3 delay clocks, and then for the three instructions at
  ; the top of the program: TCSD
  set pins, 1 [3]
